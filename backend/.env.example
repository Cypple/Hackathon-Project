# -------------------------------------------------------------------------
# COPY THIS FILE TO ".env" AND FILL IN THE REAL VALUES.
#   Windows: copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# ".env" holds the real secrets and is IGNORED by git (never committed).
# ".env.example" holds only fake placeholder values and IS committed, so
# every teammate knows which variables they need.
# -------------------------------------------------------------------------

# --- Application ---------------------------------------------------------
# Name shown in the auto-generated API docs.
APP_NAME=MPLADS Backend
# Version string of our backend.
APP_VERSION=0.1.0
# "development" while coding, "production" on a real server.
ENVIRONMENT=development
# true = extra error detail (local only). MUST be false in production.
DEBUG=true
# How chatty the logs are: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- CORS ----------------------------------------------------------------
# Which frontend addresses may call this API from a browser.
# Comma-separated, no spaces. Add your frontend's real URL later.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Supabase (used from Stage 3 onwards) --------------------------------
# Find these in Supabase dashboard -> Project Settings -> API.
# Project URL, looks like https://abcdefgh.supabase.co
SUPABASE_URL=
# "anon"/publishable key. Safe-ish: it respects database access rules.
SUPABASE_ANON_KEY=
# "service_role" key. VERY SECRET: it bypasses all access rules.
# Never put this in frontend code and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
